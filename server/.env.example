PORT=8000
SUPABASE_URL=https://your-supabase-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
QUEUE_APPROACHING_THRESHOLD=2
CORS_ORIGIN=*

# ==============================================================================
# EMAIL NOTIFICATION CONFIGURATION
# ==============================================================================
# Enter your Gmail or SMTP address
EMAIL_USER=your-email@gmail.com

# Enter your 16-character Google App Password (not your normal Gmail login password)
EMAIL_PASS=abcd efgh ijkl mnop

# SMTP Server Settings (Default is Gmail SSL port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_FROM="QueueKisan <your-email@gmail.com>"
NOTIFICATION_EMAIL_ENABLED=true
